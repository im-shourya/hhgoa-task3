# HH Goa 2026 — Phase 3 Configuration
# Copy this file to .env and fill in your values

# Face Engine Configuration
FACE_MODEL_NAME=buffalo_l
FACE_DET_SIZE=640,640
FACE_CTX_ID=0
FACE_DET_THRESH=0.5

# Face Matching Threshold (cosine similarity)
FACE_MATCH_THRESHOLD=0.45

# Image Retrieval Configuration
RETRIEVAL_TIMEOUT=10
RETRIEVAL_MAX_SIZE=10485760
RETRIEVAL_ALLOWED_SCHEMES=https
RETRIEVAL_BLOCKED_HOSTS=localhost,127.0.0.1,0.0.0.0,::1,169.254.169.254,metadata.google.internal
RETRIEVAL_BLOCKED_PRIVATE_RANGES=true

# Search Provider Configuration
SEARCH_PROVIDER=mock
SEARCH_MAX_RESULTS=10
SEARCH_API_KEY=
SEARCH_CX=

# General
LOG_LEVEL=INFO